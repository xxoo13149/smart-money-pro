{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "smart-money-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "ADMIN_BASE_URL": "https://admin.lukaluka.fun",
    "ADMIN_APPROVAL_OWNER_EMAIL": "3236064212@qq.com",
    "ADMIN_APPROVAL_SENDER_EMAIL": "noreply@lukaluka.fun",
    "ADMIN_APPROVAL_SENDER_NAME": "Smart Money Admin",
    "ADMIN_APPROVAL_CODE_TTL_MINUTES": "10",
    "ADMIN_APPROVAL_RESEND_COOLDOWN_SECONDS": "60",
    "PUBLIC_EXTENSION_BASE_URL": "https://app.lukaluka.fun",
    "POLYMARKET_GAMMA_URL": "https://gamma-api.polymarket.com",
    "POLYMARKET_DATA_URL": "https://data-api.polymarket.com"
  },
  "kv_namespaces": [
    {
      "binding": "SMART_MONEY_CACHE",
      "id": "330bf98ab1f5497da68fba5c37152e02",
      "preview_id": "330bf98ab1f5497da68fba5c37152e02"
    }
  ],
  "d1_databases": [
    {
      "binding": "SMART_MONEY_DB",
      "database_name": "smart-money-prod",
      "database_id": "04eb8a8b-1479-4ad3-b2af-901f356ab64c"
    }
  ],
  "routes": [
    {
      "pattern": "admin.lukaluka.fun",
      "custom_domain": true
    }
  ]
}
