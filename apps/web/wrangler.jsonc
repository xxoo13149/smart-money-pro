{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "smart-money-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "ADMIN_BASE_URL": "https://admin.example.com",
    "ADMIN_APPROVAL_OWNER_EMAIL": "owner@example.com",
    "ADMIN_APPROVAL_SENDER_EMAIL": "noreply@example.com",
    "ADMIN_APPROVAL_SENDER_NAME": "Smart Money Admin",
    "ADMIN_APPROVAL_CODE_TTL_MINUTES": "10",
    "ADMIN_APPROVAL_RESEND_COOLDOWN_SECONDS": "60",
    "PUBLIC_EXTENSION_BASE_URL": "https://app.example.com",
    "POLYMARKET_GAMMA_URL": "https://gamma-api.polymarket.com",
    "POLYMARKET_DATA_URL": "https://data-api.polymarket.com"
  },
  "kv_namespaces": [
    {
      "binding": "SMART_MONEY_CACHE",
      "id": "kv_namespace_id",
      "preview_id": "kv_namespace_preview_id"
    }
  ],
  "d1_databases": [
    {
      "binding": "SMART_MONEY_DB",
      "database_name": "smart-money-prod",
      "database_id": "d1_database_id"
    }
  ],
  "routes": [
    {
      "pattern": "admin.example.com",
      "custom_domain": true
    }
  ]
}
